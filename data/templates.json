        "Faq": {
          "variants": {
            "PetFaq2": {
              "subtitle": "FREQUENTLY ASKED QUESTIONS",
              "title1": "Clear Answers to",
              "highlightedTitle": "Common Questions",
              "description": "Here are quick, simple answers to the questions pet parents ask us most often.",
              "expandLabel": "Expand answer",
              "collapseLabel": "Collapse answer",
              "items": [
                {
                  "id": "faq-services",
                  "number": "01",
                  "question": "What services do you offer at PETLIO?",
                  "answer": "We provide basic health checkups, gentle grooming and baths, day care, and safe overnight boarding for dogs and cats."
                },
                {
                  "id": "faq-grooming-safety",
                  "number": "02",
                  "question": "Is grooming safe for young and older pets?",
                  "answer": "Yes. Our groomers work at your pets pace using gentle tools, warm water, and natural shampoos suited to their coat."
                },
                {
                  "id": "faq-pet-boarding",
                  "number": "03",
                  "question": "How do you care for pets during boarding?",
                  "answer": "Pets get private, clean bedding, regular walks, on-time meals, and friendly staff checking in on them 24 hours a day."
                },
                {
                  "id": "faq-daycare-timings",
                  "number": "04",
                  "question": "What are your daycare hours?",
                  "answer": "Our daycare is open Monday through Saturday from 9:00 AM to 7:00 PM. Drop-offs and pickups are easy and flexible."
                },
                {
                  "id": "faq-book-appointment",
                  "number": "05",
                  "question": "How do I book a visit?",
                  "answer": "Simply fill out the Book an Appointment form on this page, call us, or send an email. We confirm your slot quickly."
                },
                {
                  "id": "faq-vaccinations",
                  "number": "06",
                  "question": "Do pets need up-to-date vaccinations?",
                  "answer": "Yes, basic vaccinations keep all pets safe in our daycare and boarding areas. We can review your records upon booking."
                }
              ],
              "image": "/other/faq.webp",
              "imageAlt": "A golden retriever and cat resting together"
            }
          }
        },
